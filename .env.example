# Set the public production origin, without a trailing slash.
SITE_URL=https://your-domain.co.za
# Server-only email credentials. Use a sender on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM=
# Optional Cloudflare Turnstile bot protection. Set BOTH values, then redeploy.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
